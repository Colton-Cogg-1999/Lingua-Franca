#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cluster_cli=("$project_dir/tools/bin/kubectl" --kubeconfig "$project_dir/runtime/kubeconfig" -n galapagos)
cd "$project_dir"
case "${1:-status}" in
  status)
    "${cluster_cli[@]}" get jobs,pods
    python - "$project_dir/runtime/data/experiment/roman-fracture-2000/status.json" <<'PY'
import json, pathlib, sys
p=pathlib.Path(sys.argv[1])
print(json.dumps(json.loads(p.read_text()),indent=2) if p.exists() else 'Experiment has not yet committed its first round.')
PY
    ;;
  logs) "${cluster_cli[@]}" logs job/roman-fracture --tail=40 ;;
  audit)
    python -m json.tool "$project_dir/runtime/data/analytics/status.json"
    if [[ -f "$project_dir/runtime/data/experiment/roman-fracture-2000/completion-audit.json" ]]; then
      python -m json.tool "$project_dir/runtime/data/experiment/roman-fracture-2000/completion-audit.json"
    fi
    ;;
  report) "$project_dir/.venv/bin/python" -m galapagos.region_report "$project_dir/runtime/data/experiment/roman-fracture-2000" ;;
  pause) "${cluster_cli[@]}" patch job roman-fracture --type=merge -p '{"spec":{"suspend":true}}' ;;
  resume) "${cluster_cli[@]}" patch job roman-fracture --type=merge -p '{"spec":{"suspend":false}}' ;;
  *) echo 'Usage: tools/galapagosctl [status|logs|audit|report|pause|resume]' >&2; exit 2 ;;
esac
