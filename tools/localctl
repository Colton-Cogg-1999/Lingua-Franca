#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_dir"
docker=("$project_dir/tools/bin/docker" --host "unix:///run/user/$(id -u)/galapagos-docker.sock")
python="$project_dir/.venv/bin/python"
start_service() {
 local name="$1" memory="$2" cpu="$3"
 shift 3
 if systemctl --user is-active --quiet "$name"; then return; fi
 systemctl --user reset-failed "$name" 2>/dev/null || true
 systemd-run --user --unit="$name" --property="MemoryMax=$memory" --property="CPUQuota=$cpu" --property=Nice=10 --working-directory="$project_dir" "$@"
}
ensure_broker() {
 if ! "${docker[@]}" info >/dev/null 2>&1; then
  if ! systemctl --user start galapagos-docker.service 2>/dev/null; then
   systemd-run --user --unit=galapagos-docker --property=Delegate=yes --setenv="PATH=$project_dir/tools/bin:/usr/bin" "$project_dir/tools/bin/dockerd-rootless.sh" --host="unix:///run/user/$(id -u)/galapagos-docker.sock" --data-root="$project_dir/runtime/docker" --exec-root="/run/user/$(id -u)/galapagos-docker-exec" --pidfile="/run/user/$(id -u)/galapagos-docker.pid"
  fi
  for _ in {1..20}; do if "${docker[@]}" info >/dev/null 2>&1; then break; fi; sleep .5; done
 fi
 if "${docker[@]}" container inspect galapagos-ledger >/dev/null 2>&1; then
  "${docker[@]}" start galapagos-ledger >/dev/null
 else
  mkdir -p runtime/local-data/redpanda
  "${docker[@]}" run -d --name galapagos-ledger --restart=no --cpus=1 --memory=1536m --memory-swap=1536m --user=0 -p 127.0.0.1:19092:19092 -v "$project_dir/runtime/local-data/redpanda:/var/lib/redpanda/data" docker.redpanda.com/redpandadata/redpanda:v26.2.2 redpanda start --mode dev-container --smp 1 --memory 1G --reserve-memory 0M --kafka-addr 0.0.0.0:19092 --advertise-kafka-addr 127.0.0.1:19092 --set redpanda.internal_topic_replication_factor=1
 fi
 local ready=false
 for _ in {1..30}; do
  if "${docker[@]}" exec galapagos-ledger rpk cluster info -X brokers=127.0.0.1:19092 >/dev/null 2>&1; then ready=true; break; fi
  sleep 1
 done
 if [[ "$ready" != true ]]; then echo 'Ledger not ready; no simulation started.' >&2; exit 1; fi
 if ! "${docker[@]}" exec galapagos-ledger rpk topic describe galapagos.evolution.v2 -X brokers=127.0.0.1:19092 >/dev/null 2>&1; then
  "${docker[@]}" exec galapagos-ledger rpk topic create galapagos.evolution.v2 -X brokers=127.0.0.1:19092 --partitions 1 --replicas 1 -c retention.ms=-1 -c retention.bytes=-1 -c write.caching=false -c max.message.bytes=4194304
 fi
 "${docker[@]}" exec galapagos-ledger rpk topic alter-config galapagos.evolution.v2 -X brokers=127.0.0.1:19092 --set retention.ms=-1 --set retention.bytes=-1 --set write.caching=false --set max.message.bytes=4194304
}
case "${1:-status}" in
 start|resume)
  ensure_broker
  start_service galapagos-local-analytics 512M 50% "$python" -m galapagos.analytics --brokers 127.0.0.1:19092 --database runtime/local-data/analytics/projection.sqlite
  start_service galapagos-local-suite 2G 200% "$python" -m galapagos.suite --execution local --workers 2 --brokers 127.0.0.1:19092 --plans examples --output runtime/local-data/experiment
  start_service galapagos-local-reports 512M 25% "$project_dir/tools/watch-local"
  ;;
 status)
  systemctl --user list-units --all --no-legend 'galapagos-local*'
  "$python" - <<'PY'
from pathlib import Path
import json
root=Path('runtime/local-data/experiment')
for p in [root/'suite-status.json',*sorted(root.glob('historical-*/status.json'))]:
 if p.exists():print(p, json.dumps(json.loads(p.read_text()),indent=2))
PY
  ;;
 logs) journalctl --user -u galapagos-local-suite --no-pager -n 20 ;;
 audit)
  "$python" -m json.tool runtime/local-data/analytics/status.json
  for run in historical-main historical-continuous historical-related; do
   file="runtime/local-data/experiment/$run/completion-audit.json"
   if [[ -f "$file" ]]; then "$python" -m json.tool "$file"; fi
  done
  ;;
 report) "$python" -m galapagos.region_report "runtime/local-data/experiment/${2:-historical-main}" ;;
 pause) systemctl --user stop galapagos-local-suite ;;
 shutdown)
  systemctl --user stop galapagos-local-suite galapagos-local-reports galapagos-local-analytics 2>/dev/null || true
  "${docker[@]}" stop --timeout 30 galapagos-ledger
  systemctl --user stop galapagos-docker
  ;;
 *) echo 'Usage: tools/localctl [start|resume|status|logs|audit|report [run]|pause|shutdown]' >&2; exit 2 ;;
esac
